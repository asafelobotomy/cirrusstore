# The CirrusUX release whose cirrusstore tool signs and checks this
# catalogue. scripts/tool.sh builds it from this tag and refuses a checkout
# whose commit differs. Raise both together, and never below the newest
# minVersion in defs/.
CIRRUSUX_TAG=v0.10.0
