{
  "id": "uptime-kuma",
  "name": "Uptime Kuma",
  "description": "Watches your sites and services, and tells you when one is down.",
  "website": "https://uptime.kuma.pet",
  "icon": "Activity",
  "color": "#5cdd8b",
  "group": "Manage",
  "image": "docker.io/louislam/uptime-kuma",
  "tag": "2.5.9",
  "digest": "sha256:e88415a90dd2f7efecdbc18de0490aff292764a3ac471531bf1d0481725591bd",
  "ports": [
    {
      "name": "web",
      "container": 3001,
      "host": 3001,
      "main": true
    }
  ],
  "volumes": [
    {
      "name": "data",
      "path": "/app/data",
      "kind": "data"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "value": "{{tz}}"
    }
  ],
  "check": {
    "port": "web",
    "path": "/"
  },
  "minMemoryMB": 256,
  "notes": "The first visit creates the admin account. Its checks keep a sleeping server awake, so it suits an always-on one."
}
