{
  "id": "audiobookshelf",
  "name": "Audiobookshelf",
  "description": "Audiobooks and podcasts, with progress synced across devices.",
  "website": "https://www.audiobookshelf.org",
  "icon": "Headphones",
  "color": "#e9a23b",
  "group": "Watch & listen",
  "image": "docker.io/advplyr/audiobookshelf",
  "tag": "2.37.2",
  "digest": "sha256:b897c33f05972fb1bf484f7487bc878fa91ec8691335c1db6e2929c3a7658efa",
  "ports": [
    {
      "name": "web",
      "container": 80,
      "host": 13378,
      "main": true
    }
  ],
  "volumes": [
    {
      "name": "config",
      "path": "/config",
      "kind": "config"
    },
    {
      "name": "metadata",
      "path": "/metadata",
      "kind": "data"
    },
    {
      "name": "audiobooks",
      "path": "/audiobooks",
      "kind": "media",
      "label": "Audiobooks folder"
    },
    {
      "name": "podcasts",
      "path": "/podcasts",
      "kind": "media",
      "writable": true,
      "label": "Podcasts folder (downloads go here)"
    }
  ],
  "env": [
    {
      "name": "TZ",
      "value": "{{tz}}"
    }
  ],
  "check": {
    "port": "web",
    "path": "/healthcheck"
  },
  "minMemoryMB": 256,
  "notes": "The first visit creates the root user."
}
