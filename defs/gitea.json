{
  "id": "gitea",
  "name": "Gitea",
  "description": "Keep your code in Git repositories of your own, with issues and pull requests.",
  "website": "https://about.gitea.com",
  "icon": "GitBranch",
  "color": "#609926",
  "group": "Tools",
  "image": "docker.io/gitea/gitea",
  "tag": "28.4.0",
  "digest": "sha256:aa90e8f00b755b0d665214ab9c14447ea44d3190dbe6b6d0cb46cd9c4f55d309",
  "ports": [
    {
      "name": "web",
      "container": 3000,
      "host": 3000,
      "main": true
    },
    {
      "name": "ssh",
      "container": 22,
      "host": 2222
    }
  ],
  "volumes": [
    {
      "name": "data",
      "path": "/data",
      "kind": "data"
    }
  ],
  "env": [
    {
      "name": "USER_UID",
      "value": "{{uid}}"
    },
    {
      "name": "USER_GID",
      "value": "{{gid}}"
    },
    {
      "name": "TZ",
      "value": "{{tz}}"
    },
    {
      "name": "GITEA__SERVER__SSH_PORT",
      "value": "2222"
    }
  ],
  "check": {
    "port": "web",
    "path": "/api/healthz"
  },
  "minMemoryMB": 256,
  "notes": "The first visit shows the setup page: keep SQLite, set the server's address, and create the admin account at the bottom. Git over SSH uses port 2222."
}
